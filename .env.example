# ── Substrate — Environment Variables ─────────────────────────────
#
# Copy this file to .env.local and fill in the values.
# Variables marked [REQUIRED] must be set before the app can start.
# Variables marked [OPTIONAL] have sensible defaults or are feature-gated.
# Variables marked [PRESET] select a feature preset profile.

# ── Feature Preset ───────────────────────────────────────────────────

# [OPTIONAL] Selects which feature preset to activate at startup.
# Values: minimal | graphics | ai-archive | realtime | full
# Defaults to 'full' in development, 'minimal' in production.
FEATURE_PROFILE=

# ── Core ────────────────────────────────────────────────────────────

# [REQUIRED] Base URL of the deployed site.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# [REQUIRED] Secret used to sign auth sessions and cookies.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# [REQUIRED] PostgreSQL connection string (PostgreSQL 17+ with pgvector).
DATABASE_URL=postgresql://user:password@localhost:5432/substrate

# ── Auth (OAuth) ──────────────────────────────────────────────────────

# [OPTIONAL] GitHub OAuth — leave blank to disable GitHub login.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ── Observability ─────────────────────────────────────────────────────

# [OPTIONAL] Sentry DSN for error tracking.
SENTRY_DSN=

# [OPTIONAL] PostHog product analytics key.
POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_SENTRY_DSN=

# [OPTIONAL] OpenTelemetry — Grafana Cloud OTLP endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=substrate
OTEL_TRACES_SAMPLE_RATE=0.1

# ── Edge (Cloudflare Workers) ─────────────────────────────────────────

# [OPTIONAL] Cloudflare account credentials for edge deployment.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# [OPTIONAL] Cloudflare Turnstile — bot protection.
# Create at: https://dash.cloudflare.com/?to=/:account/turnstile
# The secret key. Cloudflare Workers binding name: TURNSTILE_SECRET.
# Some configs use TURNSTILE_SECRET_KEY — both are accepted.
TURNSTILE_SECRET=

# [OPTIONAL] Turnstile site key (public, safe for client bundle).
# Set this or NEXT_PUBLIC_TURNSTILE_SITE_KEY when Turnstile is enabled.
TURNSTILE_SITE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# [OPTIONAL] Upstash Redis — rate limiting & caching.
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# [OPTIONAL] Comma-separated list of allowed CORS origins for the edge API.
ALLOWED_ORIGINS=http://localhost:3000

# ── AI Providers ──────────────────────────────────────────────────────

# [OPTIONAL] At least one provider required when AI features are enabled.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# [OPTIONAL] Langfuse — AI trace/eval platform.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ── Edge Read Model (Turso / libSQL) ──────────────────────────────────

# [OPTIONAL] Turso read replica for edge queries.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# [OPTIONAL] Cloudflare R2 — object storage for media and attachments.
# Set when feature `storage` is enabled.
R2_BUCKET_ID=

# [OPTIONAL] Cloudflare Queues — async processing (embeddings, indexing).
# Set when feature `queue` is enabled.
CF_QUEUE_NAME=

# [OPTIONAL] Cloudflare Durable Objects — realtime collaboration.
# Set when feature `realtime` is enabled.
CF_DO_NAMESPACE=

# ── Vercel ────────────────────────────────────────────────────────────

# [OPTIONAL] Set automatically by Vercel in production.
VERCEL_URL=

# ── Dev Environment (inotify) ─────────────────────────────────────────
#
# On Linux, `next dev --turbopack` uses inotify to watch files.
# If your OS has a low inotify limit (e.g. sandbox/containers with
# read-only /proc/sys), HMR will crash with "OS file watch limit reached".
#
# Workarounds:
#   1. Use `bun run dev:poll` — forces polling-based file watching.
#   2. Use `bun run build && bun run start` — production mode (no HMR).
#   3. If you have write access: sudo sysctl fs.inotify.max_user_watches=524288

