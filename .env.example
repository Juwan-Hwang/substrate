# ── Substrate / Aevum — Environment Variables ─────────────────────────
#
# Copy this file to .env and fill in the values.
# Variables marked [REQUIRED] must be set before the app can start.
# Variables marked [OPTIONAL] have sensible defaults or are feature-gated.

# ── Core ──────────────────────────────────────────────────────────────

# [REQUIRED] Base URL of the deployed site.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# [REQUIRED] Secret used to sign auth sessions and cookies.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# [REQUIRED] PostgreSQL connection string (PostgreSQL 17+ with pgvector).
DATABASE_URL=postgresql://user:password@localhost:5432/aevum

# ── Auth (OAuth) ──────────────────────────────────────────────────────

# [OPTIONAL] GitHub OAuth — leave blank to disable GitHub login.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ── Observability ─────────────────────────────────────────────────────

# [OPTIONAL] Sentry DSN for error tracking.
SENTRY_DSN=

# [OPTIONAL] PostHog product analytics key.
POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_SENTRY_DSN=

# [OPTIONAL] OpenTelemetry — Grafana Cloud OTLP endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=aevum-web
OTEL_TRACES_SAMPLE_RATE=0.1

# ── Edge (Cloudflare Workers) ─────────────────────────────────────────

# [OPTIONAL] Cloudflare account credentials for edge deployment.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# [OPTIONAL] Cloudflare Turnstile — bot protection.
# Create at: https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET=

# [OPTIONAL] Upstash Redis — rate limiting & caching.
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# [OPTIONAL] Comma-separated list of allowed CORS origins for the edge API.
ALLOWED_ORIGINS=http://localhost:3000

# ── AI Providers ──────────────────────────────────────────────────────

# [OPTIONAL] At least one provider required when AI features are enabled.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# [OPTIONAL] Langfuse — AI trace/eval platform.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ── Edge Read Model (Turso / libSQL) ──────────────────────────────────

# [OPTIONAL] Turso read replica for edge queries.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Vercel ────────────────────────────────────────────────────────────

# [OPTIONAL] Set automatically by Vercel in production.
VERCEL_URL=

# ── Dev Environment (inotify) ─────────────────────────────────────────
#
# On Linux, `next dev --turbopack` uses inotify to watch files.
# If your OS has a low inotify limit (e.g. sandbox/containers with
# read-only /proc/sys), HMR will crash with "OS file watch limit reached".
#
# Workarounds:
#   1. Use `bun run dev:poll` — forces polling-based file watching.
#   2. Use `bun run build && bun run start` — production mode (no HMR).
#   3. If you have write access: sudo sysctl fs.inotify.max_user_watches=524288

