{
  "name": "@substrate-platform/ui",
  "version": "0.2.0-canary.5",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": "./src/styles.css",
    "./3d-effect": {
      "import": "./dist/3d-effect.js",
      "types": "./dist/3d-effect.d.ts"
    },
    "./status-ring": {
      "import": "./dist/status-ring.js",
      "types": "./dist/status-ring.d.ts"
    },
    "./paint-worklets": {
      "import": "./dist/paint-worklets.js",
      "types": "./dist/paint-worklets.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json && bun run ../../scripts/fix-import-extensions.ts dist",
    "lint": "biome check src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "bun --filter @substrate-platform/tokens build && storybook build",
    "test-storybook": "test-storybook",
    "clean": "rm -rf dist .turbo storybook-static"
  },
  "dependencies": {
    "@substrate-platform/tokens": "workspace:*",
    "@substrate-platform/contracts": "workspace:*",
    "@radix-ui/react-slot": "^1.1.2",
    "class-variance-authority": "^0.7.1"
  },
  "devDependencies": {
    "storybook": "^8.6.0",
    "@storybook/react-vite": "^8.6.0",
    "@storybook/addon-essentials": "^8.6.0",
    "@storybook/addon-interactions": "^8.6.0",
    "@storybook/react": "^8.6.0",
    "@storybook/test-runner": "^0.22.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "files": [
    "dist/**",
    "README.md",
    "LICENSE",
    "src/**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Juwan-Hwang/substrate.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/Juwan-Hwang/substrate#readme",
  "bugs": {
    "url": "https://github.com/Juwan-Hwang/substrate/issues"
  }
}
