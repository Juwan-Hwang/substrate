{
  "name": "@substrate-platform/content",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./search": {
      "import": "./dist/search.js",
      "types": "./dist/search.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json && bun run ../../scripts/fix-import-extensions.ts dist",
    "lint": "biome check src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo .velite"
  },
  "dependencies": {
    "@substrate-platform/contracts": "workspace:*",
    "zod": "^3.24.0",
    "velite": "^0.2.0",
    "@mdx-js/react": "^3.1.0",
    "fumadocs-ui": "^15.0.0",
    "fumadocs-core": "^15.0.0",
    "fumadocs-mdx": "^11.0.0",
    "@orama/orama": "^3.1.0",
    "@vercel/og": "^0.6.5"
  },
  "devDependencies": {
    "@types/mdx": "^2.0.0"
  },
  "files": [
    "dist/**",
    "README.md",
    "LICENSE"
  ]
}
