{
  "name": "@substrate-platform/config",
  "version": "0.2.0-canary.0",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./features": {
      "import": "./dist/features.js",
      "types": "./dist/features.d.ts"
    },
    "./tsconfig": "./tsconfig.json"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json && bun run ../../scripts/fix-import-extensions.ts dist",
    "lint": "biome check src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  },
  "files": [
    "dist/**",
    "README.md",
    "LICENSE",
    "tsconfig.json"
  ]
}
