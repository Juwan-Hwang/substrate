{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "moduleResolution": "Bundler",
    "incremental": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["node"],
    "paths": {
      "@substrate/contracts": ["../../packages/contracts/src"],
      "@substrate/contracts/*": ["../../packages/contracts/src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
