# ── Database (optional) ──────────────────────────────────────────────
# Omit to run in Orama client-side fallback search mode.
# Requires PostgreSQL 17 + pgvector for hybrid (FTS + semantic) retrieval.
# DATABASE_URL=postgresql://user:pass@localhost:5432/substrate

# ── AI provider (optional) ───────────────────────────────────────────
# Omit to run in demo RAG mode (canned, citation-stamped answers).
# Used for live streaming chat and for generating embeddings on ingest.
# OPENAI_API_KEY=sk-...
