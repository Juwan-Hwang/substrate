{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "plugins": [{ "name": "next" }],
    "jsx": "preserve",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "incremental": true,
    "paths": {
      "@/*": ["./src/*"],
      "@substrate/site": ["../../packages/site/src"],
      "@substrate/site/*": ["../../packages/site/src/*"]
    }
  },
  "include": ["src", "next-env.d.ts", "*.ts"],
  "exclude": ["node_modules", ".next"]
}
