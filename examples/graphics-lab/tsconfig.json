{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    "incremental": true,
    "composite": false,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "types": ["@webgpu/types"],
    "paths": {
      "@/*": ["./src/*"],
      "@substrate-platform/site": ["../../packages/site/src"],
      "@substrate-platform/site/*": ["../../packages/site/src/*"],
      "@substrate-platform/ui": ["../../packages/ui/src"],
      "@substrate-platform/ui/*": ["../../packages/ui/src/*"],
      "@substrate-platform/config": ["../../packages/config/src"],
      "@substrate-platform/config/*": ["../../packages/config/src/*"],
      "three": ["../../packages/graphics/src/stubs/three.d.ts"],
      "three/tsl": ["../../packages/graphics/src/stubs/three-tsl.d.ts"],
      "three/webgpu": ["../../packages/graphics/src/stubs/three-webgpu.d.ts"],
      "@react-three/fiber": ["../../packages/graphics/src/stubs/r3f.d.ts"],
      "@react-three/drei": ["../../packages/graphics/src/stubs/drei.d.ts"]
    }
  },
  "include": ["src", "next.config.ts", "../../packages/graphics/src/r3f-jsx.ts"]
}
