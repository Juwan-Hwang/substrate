{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "incremental": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "paths": {
      "@substrate/web": ["./packages/web/src"],
      "@substrate/ui": ["./packages/ui/src"],
      "@substrate/content": ["./packages/content/src"],
      "@substrate/graphics": ["./packages/graphics/src"],
      "@substrate/contracts": ["./packages/contracts/src"],
      "@substrate/db": ["./packages/db/src"],
      "@substrate/edge": ["./packages/edge/src"],
      "@substrate/observability": ["./packages/observability/src"]
    }
  }
}
